{
  "manifest_version": 3,
  "name": "GlowReadTTS - Text to Speech Voice Reader",
  "short_name": "GlowReadTTS",
  "version": "1.1.0",
  "description": "On-device AI voices read selected text aloud with highlight-as-you-read. Fully offline. No accounts, no tracking.",
  "author": "Lavelle Hatcher Jr",
  
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png",
    "256": "assets/icon-256.png"
  },
  
  "permissions": [
    "activeTab",
    "contextMenus",
    "notifications",
    "offscreen",
    "scripting",
    "storage"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },

  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },

  "cross_origin_opener_policy": {
    "value": "same-origin"
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "GlowReadTTS - Click to open",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "offline_enabled": true,
  
  "minimum_chrome_version": "121",

  "web_accessible_resources": [
    {
      "resources": ["libs/kokoro/*", "libs/kokoro-model/*", "libs/onnx/*"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["eula/*"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["help/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
